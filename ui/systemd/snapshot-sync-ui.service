[Unit]
Description=Btrfs Snapshot Sync UI (API + Dashboard)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=amitp
WorkingDirectory=/home/amitp/snapshot-sync-ui
ExecStart=/usr/bin/docker compose up
Restart=on-failure
RestartSec=10

# Allow Docker socket access
Environment="DOCKER_HOST=unix:///run/docker.sock"

[Install]
WantedBy=multi-user.target
